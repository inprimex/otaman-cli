# Generated by `otaman init` — do not edit by hand; re-run `otaman init` to regenerate.
# Self-contained: depends only on `otaman` CLI + `tmux`. No otaman-plugin runtime calls.

# Execution-policy reminder (only shown if needed)
if ((Get-ExecutionPolicy) -eq 'Restricted') {
    Write-Host "WARN: PowerShell execution policy is Restricted. Run as administrator:"
    Write-Host "  Set-ExecutionPolicy -Scope CurrentUser RemoteSigned"
}

# ---------- dependency check ----------
$missing = @()
if (-not (Get-Command tmux -ErrorAction SilentlyContinue))    { $missing += "tmux" }
if (-not (Get-Command otaman -ErrorAction SilentlyContinue))  { $missing += "otaman" }

if ($missing.Count -gt 0) {
    Write-Error "missing required dependencies: $($missing -join ', ')"
    Write-Host  "  install: tmux via your OS package manager; otaman via 'pip install otaman-cli'"
    exit 1
}

if (-not (Get-Command claude -ErrorAction SilentlyContinue) -and `
    -not (Get-Command claude-code -ErrorAction SilentlyContinue)) {
    Write-Warning "neither 'claude' nor 'claude-code' is on PATH — agent sessions may fail to start."
}
{% if connection.mode == "ssh" %}

# ---------- SSH connectivity check (mode=ssh) ----------
$SshHost = "{{ connection.ssh.user }}@{{ connection.ssh.host }}"
{% if connection.ssh.key_path %}
$SshOpts = "-i {{ connection.ssh.key_path }} -o BatchMode=yes"
{% else %}
$SshOpts = "-o BatchMode=yes"
{% endif %}
$sshCheck = & ssh -q $SshOpts.Split(' ') $SshHost exit
if ($LASTEXITCODE -ne 0) {
    Write-Error "SSH connectivity check failed: ssh $SshOpts $SshHost exit"
    Write-Host  "  verify SSH key + host reachability before running this launcher."
    exit 1
}
{% endif %}

# ---------- spawn / attach sessions ----------
$Prefix  = "{{ tmux.session_prefix }}"
$Layout  = "{{ tmux.layout }}"
$Started = 0
$Skipped = 0
$Failed  = 0

function Start-AgentSession {
    param([string]$Agent)
    $Session = "$Prefix-$Agent"
    {% if connection.mode == "ssh" %}
    & ssh -q $SshOpts.Split(' ') $SshHost "tmux has-session -t $Session" 2>$null
    if ($LASTEXITCODE -eq 0) {
        Write-Host "  [skip] $Session - already running on $SshHost"
        $script:Skipped++
        return
    }
    & ssh -q $SshOpts.Split(' ') $SshHost "tmux new-session -d -s $Session -x 200 -y 50 && tmux send-keys -t $Session 'otaman start $Agent' Enter"
    if ($LASTEXITCODE -eq 0) {
        Write-Host "  [ok]   $Session - started on $SshHost"
        $script:Started++
    } else {
        Write-Host "  [fail] $Session - could not start on $SshHost"
        $script:Failed++
    }
    {% else %}
    & tmux has-session -t $Session 2>$null
    if ($LASTEXITCODE -eq 0) {
        Write-Host "  [skip] $Session - already running"
        $script:Skipped++
        return
    }
    & tmux new-session -d -s $Session -x 200 -y 50
    if ($LASTEXITCODE -eq 0) {
        & tmux send-keys -t $Session "otaman start $Agent" Enter
        Write-Host "  [ok]   $Session - started"
        $script:Started++
    } else {
        Write-Host "  [fail] $Session - tmux new-session failed"
        $script:Failed++
    }
    {% endif %}
}

Write-Host "Launching otaman sessions (prefix=$Prefix, layout=$Layout)"
{% for agent in agents %}
{% if agent.enabled %}
Start-AgentSession "{{ agent.name }}"
{% endif %}
{% endfor %}

Write-Host ""
Write-Host "Summary: started=$Started skipped=$Skipped failed=$Failed"

if ($Started -eq 0 -and $Skipped -eq 0) { exit 1 }

Write-Host "Attach: tmux attach -t $Prefix-spec-agent"
exit 0
