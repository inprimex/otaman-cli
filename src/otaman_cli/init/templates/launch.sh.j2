#!/usr/bin/env bash
# Generated by `otaman init` — do not edit by hand; re-run `otaman init` to regenerate.
# Self-contained: depends only on `otaman` CLI + `tmux`. No otaman-plugin runtime calls.

set -u

# ---------- selection: menu + arg dispatch (unified-launcher-profiles 1.2) ----------
# Back-compat is the ABSENT block (D3): with no `launch:` in launch-settings.yaml
# this whole section resolves to "full", no menu, no console — byte-compatible
# with every existing CI and automation invocation.
# Defined UNCONDITIONALLY: the legacy path's "nothing started" guard calls it
# too. It was originally inside the `launch:` block, so a legacy launcher with
# no enabled agents hit `_count: command not found` and then exited 0 — turning
# "launched nothing" into a success, which is the exact class the no-silent-
# success rule names. Caught by diffing legacy output rather than by a test.
# (`${'{'}#arr[@]}` would open a Jinja comment, hence counting via "$#".)
_count() { echo $#; }

ALL_AGENTS=({% for agent in agents %}{% if agent.enabled %}"{{ agent.name }}" {% endif %}{% endfor %})
SELECTED=("${ALL_AGENTS[@]}")
SEAT_CONSOLE=0
{% if launch %}
INCLUDE_CONSOLE={{ 1 if launch.include_console else 0 }}
CONSOLE_SOCKET="{{ launch.console.socket or 'otaman-human' }}"
CONSOLE_SESSION="{{ launch.console.session or 'otaman-console' }}"
CONSOLE_COMMAND="{{ launch.console.command or '' }}"

profile_agents() {
  case "$1" in
{% for prof in launch.profiles %}
    "{{ prof.name }}"|"{{ loop.index + 2 }}") printf '%s\n' {% for a in prof.agents %}"{{ a }}" {% endfor %};;
{% endfor %}
    *) return 1 ;;
  esac
}

profile_console() {
  case "$1" in
{% for prof in launch.profiles %}
    "{{ prof.name }}"|"{{ loop.index + 2 }}") return {{ 0 if prof.console else 1 }} ;;
{% endfor %}
    *) return 1 ;;
  esac
}

show_menu() {
  echo "Launch which set?"
  echo "  1) full — every agent"
  echo "  2) pick — choose agents"
{% for prof in launch.profiles %}
  echo "  {{ loop.index + 2 }}) {{ prof.name }} — {{ prof.agents | join(', ') or '(console only)' }}{{ '  + console' if prof.console else '' }}"
{% endfor %}
}

pick_agents() {
  local chosen=() i=1
  for a in "${ALL_AGENTS[@]}"; do echo "  $i) $a" >&2; i=$((i+1)); done
  printf 'agents (numbers or names, space separated): ' >&2
  read -r reply || return 1
  for tok in $reply; do
    if [ "$tok" -eq "$tok" ] 2>/dev/null; then
      [ "$tok" -ge 1 ] && [ "$tok" -le "$(_count "${ALL_AGENTS[@]}")" ] && chosen+=("${ALL_AGENTS[$((tok-1))]}")
    else
      chosen+=("$tok")
    fi
  done
  printf '%s\n' "${chosen[@]}"
}

apply_choice() {
  local choice="$1" lines
  case "$choice" in
    full|1) SELECTED=("${ALL_AGENTS[@]}") ;;
    pick|2)
      mapfile -t lines < <(pick_agents) || return 1
      [ "$(_count ${lines[@]+"${lines[@]}"})" -gt 0 ] || { echo "Nothing selected." >&2; return 1; }
      SELECTED=("${lines[@]}")
      ;;
    *)
      if lines="$(profile_agents "$choice")"; then
        mapfile -t SELECTED <<< "$lines"
        # An empty line from a console-only profile must not become an agent.
        [ "$(_count ${SELECTED[@]+"${SELECTED[@]}"})" -eq 1 ] && [ -z "${SELECTED[0]}" ] && SELECTED=()
        # NOT `profile_console ... && SEAT_CONSOLE=1`: that compound is the last
        # statement in the branch, so a profile WITHOUT a console makes it false
        # and the false becomes apply_choice's return status — which the caller
        # reads as "selection failed" and exits on. Every non-console profile
        # was unusable. Explicit `if`, explicit `return 0`.
        if profile_console "$choice"; then SEAT_CONSOLE=1; fi
      else
        echo "Unknown selection: $choice" >&2
        return 1
      fi
      ;;
  esac
  return 0
}

CHOICE="${1:-}"
if [ -z "$CHOICE" ]; then
  # A menu only where a human is present. No TTY -> full (D3), which is what
  # every existing automated caller gets today.
  if [ -t 0 ] && [ -t 1 ]; then
    show_menu
    printf 'choice [1]: '
    read -r CHOICE || CHOICE="full"
    CHOICE="${CHOICE:-full}"
  else
    CHOICE="full"
  fi
fi
apply_choice "$CHOICE" || exit 1
[ "$INCLUDE_CONSOLE" = "1" ] && SEAT_CONSOLE=1
{% endif %}
{% if connection.mode == "mesh" %}
# ========== mesh: runner-mediated spawn (Path B — no SSH, no tmux) ==========
command -v curl   >/dev/null 2>&1 || { echo "ERROR: curl is required for mesh mode" >&2; exit 1; }
command -v otaman >/dev/null 2>&1 || { echo "ERROR: otaman is required" >&2; exit 1; }

RUNNER_BASE="{{ connection.mesh.http_base }}"

# Token is read at RUNTIME from the token source — NEVER embedded in this file.
TOKEN_SRC="{{ connection.mesh.token_source or 'OTAMAN_RUNNER_TOKEN' }}"
if [ -f "$TOKEN_SRC" ]; then
  RUNNER_TOKEN="$(grep -E '^OTAMAN_RUNNER_TOKEN=' "$TOKEN_SRC" | tail -1 | cut -d= -f2- | tr -d '"')"
else
  RUNNER_TOKEN="${!TOKEN_SRC:-}"
fi
if [ -z "$RUNNER_TOKEN" ]; then
  echo "ERROR: runner token not found (source: $TOKEN_SRC) — it is never stored in this launcher." >&2
  echo "  set the token (env var or secrets.env line OTAMAN_RUNNER_TOKEN=...) before running." >&2
  exit 1
fi

started=0
failed=0
spawn_agent() {
  local agent="$1" repo="$2" tmp code
  tmp="$(mktemp)"
  # Bounded timeouts: a black-holed endpoint (SYN dropped — down VPN, wrong mesh
  # route) would otherwise hang the launcher forever. --max-time makes it a loud,
  # finite failure. curl -w prints the code (000 on connect/timeout failure); a
  # redundant echo-fallback would double-print it to 000000, so we rely on -w.
  code="$(curl -sS --connect-timeout 5 --max-time 30 -o "$tmp" -w '%{http_code}' \
    -X POST "$RUNNER_BASE/spawn" \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer $RUNNER_TOKEN" \
    --data "{\"agent\":\"$agent\",\"repo\":\"$repo\",\"mode\":\"interactive\"}" 2>/dev/null)"
  code="${code:-000}"
  if [ "$code" = "200" ] || [ "$code" = "201" ]; then
    echo "  [ok]   $agent — spawned via runner ($RUNNER_BASE)"
    started=$((started+1))
  else
    echo "  [fail] $agent — runner /spawn returned ${code:-unreachable}" >&2
    sed 's/^/         /' "$tmp" >&2 2>/dev/null || true
    failed=$((failed+1))
  fi
  rm -f "$tmp"
}

agent_repo() {
  case "$1" in
{% for name, rel in agent_repos.items() %}
    "{{ name }}") echo "{{ rel }}" ;;
{% endfor %}
    *) echo "" ;;
  esac
}

echo "Spawning otaman agents via runner $RUNNER_BASE"
# Factored over the SELECTED list (1.2) — the same loop the local/ssh mode runs,
# so a profile means the same thing in every connection mode instead of being a
# feature one path has and the other does not.
for _agent in ${SELECTED[@]+"${SELECTED[@]}"}; do
  spawn_agent "$_agent" "$(agent_repo "$_agent")"
done

echo
echo "Summary: spawned=$started failed=$failed"
if [ "$failed" -ne 0 ]; then exit 1; fi
if [ "$started" -eq 0 ] && [ "${SEAT_CONSOLE:-0}" != "1" ]; then exit 1; fi

{% if launch %}
# ---------- console seat (1.2/1.3, D1) ----------
# Delegated to `otaman console seat`, deliberately: the rule about WHICH tmux
# server may hold a human console lives in one place in Python, not in a
# template a tenant edit could quietly move onto the fleet socket. A refusal is
# loud and non-zero here, so a launcher never reports success for a seat that
# did not happen.
if [ "${SEAT_CONSOLE:-0}" = "1" ]; then
  echo
  echo "Seating the human console…"
  _seat_args=(--socket "$CONSOLE_SOCKET" --session "$CONSOLE_SESSION")
  [ -n "$CONSOLE_COMMAND" ] && _seat_args+=(--command "$CONSOLE_COMMAND")
  if ! otaman console seat "${_seat_args[@]}"; then
    echo "  the console seat was refused — see the message above" >&2
    exit 1
  fi
fi
{% endif %}
exit 0
{% else %}
# ---------- dependency check ----------
missing=()
command -v tmux >/dev/null 2>&1 || missing+=("tmux")
command -v otaman >/dev/null 2>&1 || missing+=("otaman")

if [ {% raw %}${#missing[@]}{% endraw %} -gt 0 ]; then
  echo "ERROR: missing required dependencies: ${missing[*]}" >&2
  echo "  install: tmux via your OS package manager; otaman via 'pip install otaman-cli'" >&2
  exit 1
fi

if ! command -v claude >/dev/null 2>&1 && ! command -v claude-code >/dev/null 2>&1; then
  echo "WARN: neither 'claude' nor 'claude-code' is on PATH — agent sessions may fail to start." >&2
fi
{% if connection.mode == "ssh" %}

# ---------- SSH connectivity check (mode=ssh) ----------
SSH_HOST="{{ connection.ssh.user }}@{{ connection.ssh.host }}"
{% if connection.ssh.key_path %}
SSH_OPTS="-i {{ connection.ssh.key_path }} -o BatchMode=yes"
{% else %}
SSH_OPTS="-o BatchMode=yes"
{% endif %}
if ! ssh -q $SSH_OPTS "$SSH_HOST" exit; then
  echo "ERROR: SSH connectivity check failed: ssh $SSH_OPTS $SSH_HOST exit" >&2
  echo "  verify SSH key + host reachability before running this launcher." >&2
  exit 1
fi
{% endif %}

# ---------- spawn / attach sessions ----------
PREFIX="{{ tmux.session_prefix }}"
LAYOUT="{{ tmux.layout }}"
started=0
skipped=0
failed=0

{% if connection.mode == "ssh" %}
# Repo base ON THE REMOTE HOST (otaman meta dir there). From
# launch-settings.yaml connection.ssh.remote_root; override per-run with
# OTAMAN_REMOTE_REPOS_BASE.
REMOTE_REPOS_BASE="${OTAMAN_REMOTE_REPOS_BASE:-{{ connection.ssh.remote_root or "" }}}"
{% else %}
# Repo paths in platform.yaml are relative to the otaman meta dir, and this
# launcher/ folder lives inside it — so default the base to the parent of
# this script. Override with OTAMAN_REPOS_BASE when the folder is copied
# elsewhere.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPOS_BASE="${OTAMAN_REPOS_BASE:-$(cd "$SCRIPT_DIR/.." && pwd)}"
{% endif %}

# Meta-dir-relative repo path for an agent (from platform.yaml repos[]).
agent_repo() {
  case "$1" in
{% for name, rel in agent_repos.items() %}
    "{{ name }}") echo "{{ rel }}" ;;
{% endfor %}
    *) echo "" ;;
  esac
}

# The command each pane runs: cd into the agent's repo and start claude.
# Unknown agent / missing dir -> visible guidance in the pane, never empty.
pane_cmd() {
  local agent="$1" rel
  rel="$(agent_repo "$agent")"
  {% if connection.mode == "ssh" %}
  if [ -n "$rel" ] && [ -n "$REMOTE_REPOS_BASE" ]; then
    printf 'cd %s/%s && claude' "$REMOTE_REPOS_BASE" "$rel"
  else
    printf 'echo "[otaman] set connection.ssh.remote_root in launch-settings.yaml (or OTAMAN_REMOTE_REPOS_BASE), then cd into the %s repo and run: claude"' "$agent"
  fi
  {% else %}
  if [ -n "$rel" ] && [ -d "$REPOS_BASE/$rel" ]; then
    printf 'cd %q && claude' "$REPOS_BASE/$rel"
  else
    printf 'echo "[otaman] no repo dir found for %s (expected $REPOS_BASE/%s) — cd into its repo and run: claude"' "$agent" "${rel:-unmapped}"
  fi
  {% endif %}
}

start_session() {
  local agent="$1"
  local session="$PREFIX-$agent"
  {% if connection.mode == "ssh" %}
  if ssh -q $SSH_OPTS "$SSH_HOST" "tmux has-session -t $session" 2>/dev/null; then
    echo "  [skip] $session — already running on $SSH_HOST"
    skipped=$((skipped+1))
    return
  fi
  if ssh -q $SSH_OPTS "$SSH_HOST" "tmux new-session -d -s $session -x 200 -y 50 && tmux send-keys -t $session \"$(pane_cmd "$agent")\" Enter"; then
    echo "  [ok]   $session — started on $SSH_HOST"
    started=$((started+1))
  else
    echo "  [fail] $session — could not start on $SSH_HOST"
    failed=$((failed+1))
  fi
  {% else %}
  if tmux has-session -t "$session" 2>/dev/null; then
    echo "  [skip] $session — already running"
    skipped=$((skipped+1))
    return
  fi
  if tmux new-session -d -s "$session" -x 200 -y 50; then
    tmux send-keys -t "$session" "$(pane_cmd "$agent")" Enter
    echo "  [ok]   $session — started"
    started=$((started+1))
  else
    echo "  [fail] $session — tmux new-session failed"
    failed=$((failed+1))
  fi
  {% endif %}
}

echo "Launching otaman sessions (prefix=$PREFIX, layout=$LAYOUT)"
for _agent in ${SELECTED[@]+"${SELECTED[@]}"}; do
  start_session "$_agent"
done

echo
echo "Summary: started=$started skipped=$skipped failed=$failed"

# Failure is "NOTHING happened", and seating a console counts as something. A
# console-only profile legitimately starts no sessions; exiting here would kill
# it before the console is seated, which is the whole point of such a profile.
#
# Keyed on SEAT_CONSOLE rather than on "were any agents selected": the latter
# also made a LEGACY launcher with zero enabled agents exit 0, turning "launched
# nothing" into a success. Legacy has SEAT_CONSOLE=0, so this is byte-identical
# in behaviour to the original guard for every pre-existing configuration.
if [ "$started" -eq 0 ] && [ "$skipped" -eq 0 ] && [ "${SEAT_CONSOLE:-0}" != "1" ]; then
  exit 1
fi


{% if launch %}
# ---------- console seat (1.2/1.3, D1) ----------
# Delegated to `otaman console seat`, deliberately: the rule about WHICH tmux
# server may hold a human console lives in one place in Python, not in a
# template a tenant edit could quietly move onto the fleet socket. A refusal is
# loud and non-zero here, so a launcher never reports success for a seat that
# did not happen.
if [ "${SEAT_CONSOLE:-0}" = "1" ]; then
  echo
  echo "Seating the human console…"
  _seat_args=(--socket "$CONSOLE_SOCKET" --session "$CONSOLE_SESSION")
  [ -n "$CONSOLE_COMMAND" ] && _seat_args+=(--command "$CONSOLE_COMMAND")
  if ! otaman console seat "${_seat_args[@]}"; then
    echo "  the console seat was refused — see the message above" >&2
    exit 1
  fi
fi
{% endif %}

{% if launch %}
# With profiles, the first agent depends on the SELECTION, so the hint is
# computed at runtime.
if [ "$(_count ${SELECTED[@]+"${SELECTED[@]}"})" -gt 0 ]; then
  echo "Attach: tmux attach -t $PREFIX-${SELECTED[0]}"
fi
{% else %}
{# Legacy shape kept byte-identical (D3): an absent `launch:` block must
   reproduce today's launcher exactly, down to this line. #}
{% set _enabled = agents | selectattr('enabled') | map(attribute='name') | list %}
{% if _enabled %}
echo "Attach: tmux attach -t $PREFIX-{{ _enabled[0] }}"
{% endif %}
{% endif %}
exit 0
{% endif %}
